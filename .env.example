# Copy to .env to change a default. Nothing here is required: none of the
# three services needs a key or an account.
#
# The server reads .env from the directory it is started in -- the
# repository root, when launched with `uv --directory /path/to/norway-archives-mcp`.
# Variables already set in the environment take precedence.

# Optional: an email address or URL added to the User-Agent, so an archive
# can reach you if your use ever causes it trouble.
# NORWAY_ARCHIVES_CONTACT=you@example.org

# Optional: directory for the on-disk cache and the daily request count.
# NORWAY_ARCHIVES_CACHE_DIR=~/.cache/norway-archives-mcp

# Optional: HTTP timeout in seconds for one request (default 30; image
# downloads get 120 to read).
# NORWAY_ARCHIVES_TIMEOUT=30

# Optional: least seconds between two Digitalarkivet requests (default 5,
# never below 5; the archive asks crawlers for 5).
# NORWAY_ARCHIVES_DA_INTERVAL=5

# Optional: most live Digitalarkivet requests per UTC day (default 600).
# NORWAY_ARCHIVES_DA_DAILY_BUDGET=600

# Optional: an existing folder that every download destination must lie
# inside. The downloads never write under ~/Library otherwise; set this to
# save into an iCloud Drive folder, which lives there.
# NORWAY_ARCHIVES_DOWNLOAD_DIR="~/Library/Mobile Documents/com~apple~CloudDocs/Genealogy"
